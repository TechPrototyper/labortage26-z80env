{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Assemble (sjasmplus)",
      "type": "shell",
      "command": "sjasmplus --nologo --dirbol --raw=${fileBasenameNoExtension}.bin --lst=${fileBasenameNoExtension}.lst ${file}",
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "sjasmplus",
        "fileLocation": ["relative", "${fileDirname}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\):\\s+(error|warning):\\s+(.*)$",
          "file": 1, "line": 2, "severity": 3, "message": 4
        }
      }
    }
  ]
}
